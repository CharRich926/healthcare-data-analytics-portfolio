      <Query>
        <DataSourceName>HealthcarePractice</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT TOP 20 claim_id, provider_id, billed_amount, claim_status
FROM dbo.claims</CommandText>
      </Query>
